
# Mesocyclone Products
  Prod_Schedule.mdaprod.disabled	value = Yes;
					type = string;
					range = { No, Yes };
					enum = 0, 1;
					description = Should product(s) be disabled?;
					default = No;

  Prod_Schedule.mdaprod.prod_id		value = -1;
					type = int;
					range = [-1, 2999];
					description = Product(s) to be disabled ... -1 = all;
					default = -1;

  Prod_Schedule.mdaprod.vcp		value = -12, -212;
					type = int;
					range = [-999, 999];
					description = Volume Coverage Pattern (VCP);
					default = 0;

