{
	"name": "lamula-process",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build:assets": "node scripts/build-assets.mjs",
		"build": "node scripts/build-assets.mjs && vite build",
		"preview": "vite preview",
		"postinstall": "node scripts/build-assets.mjs",
		"prepare": "svelte-kit sync || echo '' && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && node scripts/check-i18n.mjs",
		"check:i18n": "node scripts/check-i18n.mjs",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm test:unit -- --run",
		"tauri": "tauri"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/cli": "2.11.4",
		"@types/d3-scale": "^4.0.9",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"happy-dom": "^20.11.1",
		"husky": "^9.1.7",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@tauri-apps/api": "2.11.1",
		"@xstate/svelte": "^5.0.0",
		"bzip2-wasm": "^1.0.1",
		"d3-scale": "^4.0.2",
		"ol": "10.9.0",
		"pixi.js": "^8.19.0",
		"svelte-i18n": "4.0.1",
		"xstate": "5.32.5"
	}
}
